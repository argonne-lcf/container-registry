bootstrap: docker
From: ubuntu:22.04

%environment
 export PATH=$PATH:/mpich/install/bin
 export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/mpich/install/lib
 export PYTHONPATH=/usr/local/lib/python3.10/dist-packages

%files
 source/* /usr/source/
 build_mpich_3.4.3.sh /usr/

%post
 DEBIAN_FRONTEND=noninteractive
 apt-get update -y \
 && DEBIAN_FRONTEND=noninteractive \
 && apt-get install -y build-essential libfabric-dev libibverbs-dev gfortran wget \
 && apt-get install -y python3 python3-distutils python3-pip gcc git
 # Create directory for MPICH installation
 mkdir -p /mpich/install
 #chmod +x /usr/build_mpich_4.sh
 chmod +x /usr/build_mpich_3.4.3.sh
 #/usr/build_mpich_4.sh
 /usr/build_mpich_3.4.3.sh
 echo "--- Installing mpi4py ---"
 # Ensure pip uses the correct MPI environment
 export PATH=/mpich/install/bin:$PATH
 export LD_LIBRARY_PATH=/mpich/install/lib:$LD_LIBRARY_PATH
 pip install mpi4py
 #pip install --no-cache-dir cython
 #git clone https://github.com/mpi4py/mpi4py.git
 #cd mpi4py
 # Configure mpi4py to use our specific MPICH installation
 #echo "[mpi]" > mpi.cfg
 #echo "mpicc = /mpich/install/bin/mpicc" >> mpi.cfg
 #echo "mpicxx = /mpich/install/bin/mpicxx" >> mpi.cfg
 #echo "include_dirs = /mpich/install/include" >> mpi.cfg
 #echo "library_dirs = /mpich/install/lib" >> mpi.cfg

 # Build and install mpi4py
 #python3 setup.py build --mpi=mpich
 #python3 setup.py install

 # Verify installation
 python3 -c "from mpi4py import MPI; print(MPI.Get_library_version())"

 # Clean up
 cd /
 #rm -rf /tmp/mpi4py
 
%labels
 MAINTAINER Aditya atanikanti@anl.gov

%help
 This is container is used to illustrate a mpi based def file to build a container running python and c programs